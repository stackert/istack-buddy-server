# Redis and BullMQ Environment Configuration
# Copy this file to .env and update values for your environment

# =============================================================================
# Redis Configuration
# =============================================================================

# Redis Server Connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Redis Connection Pool Settings
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000
REDIS_RETRY_DELAY_ON_FAILURE=100
REDIS_MAX_RETRIES_PER_REQUEST=3

# =============================================================================
# BullMQ Configuration
# =============================================================================

# BullMQ Redis Connection (can be different from main Redis)
BULLMQ_REDIS_HOST=localhost
BULLMQ_REDIS_PORT=6379
BULLMQ_REDIS_PASSWORD=
BULLMQ_REDIS_DB=1

# BullMQ Connection Pool Settings
BULLMQ_CONNECT_TIMEOUT=10000
BULLMQ_COMMAND_TIMEOUT=5000
BULLMQ_RETRY_DELAY_ON_FAILURE=100
BULLMQ_MAX_RETRIES_PER_REQUEST=3

# =============================================================================
# Job Queue Configuration
# =============================================================================

# Queue Processing Settings
JOB_QUEUE_CONCURRENCY=5
JOB_QUEUE_ATTEMPTS=3
JOB_QUEUE_BACKOFF_DELAY=2000
JOB_QUEUE_BACKOFF_TYPE=exponential
JOB_QUEUE_REMOVE_ON_COMPLETE=100
JOB_QUEUE_REMOVE_ON_FAIL=50

# Queue-specific Settings
MESSAGE_QUEUE_CONCURRENCY=3
FILE_PROCESSING_QUEUE_CONCURRENCY=2
NOTIFICATION_QUEUE_CONCURRENCY=5

# Job Timeout Settings (in milliseconds)
JOB_TIMEOUT=300000  # 5 minutes
MESSAGE_JOB_TIMEOUT=60000  # 1 minute
FILE_PROCESSING_JOB_TIMEOUT=300000  # 5 minutes
NOTIFICATION_JOB_TIMEOUT=30000  # 30 seconds

# =============================================================================
# File Manager Configuration
# =============================================================================

# File Storage Settings
FILE_STORAGE_BASE_PATH=./storage
FILE_STORAGE_TEMP_PATH=./storage/temp
FILE_STORAGE_SHORT_TERM_PATH=./storage/short-term

# File Cleanup Settings (in milliseconds)
TEMP_FILE_CLEANUP_INTERVAL=3600000  # 1 hour
TEMP_FILE_MAX_AGE=86400000  # 24 hours
SHORT_TERM_FILE_MAX_AGE=604800000  # 7 days

# File Size Limits (in bytes)
MAX_FILE_SIZE=10485760  # 10MB
MAX_TEMP_FILE_SIZE=5242880  # 5MB

# =============================================================================
# Bull Board Dashboard Configuration
# =============================================================================

# Dashboard Settings
BULL_BOARD_BASE_PATH=/admin/queues
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=admin123  # Change in production!

# =============================================================================
# Development vs Production Settings
# =============================================================================

# Environment
NODE_ENV=development

# Logging
LOG_LEVEL=debug
LOG_JOB_QUEUE_OPERATIONS=true
LOG_FILE_OPERATIONS=true

# =============================================================================
# Production Overrides (uncomment for production)
# =============================================================================

# NODE_ENV=production
# LOG_LEVEL=info
# LOG_JOB_QUEUE_OPERATIONS=false
# LOG_FILE_OPERATIONS=false

# # Production Redis Security
# REDIS_PASSWORD=your_secure_redis_password
# BULLMQ_REDIS_PASSWORD=your_secure_redis_password

# # Production Dashboard Security
# BULL_BOARD_USERNAME=your_admin_username
# BULL_BOARD_PASSWORD=your_secure_password

# # Production File Storage
# FILE_STORAGE_BASE_PATH=/var/lib/istack-buddy/storage
# FILE_STORAGE_TEMP_PATH=/var/lib/istack-buddy/storage/temp
# FILE_STORAGE_SHORT_TERM_PATH=/var/lib/istack-buddy/storage/short-term
